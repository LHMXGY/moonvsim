S_000001b4dabf7fd0 .scope module, "t_display2" "t_display2" 2 2;
 .timescale 0 0;
v000001b4dabfee60_0 .var "v", 7 0;
    .scope S_000001b4dabf7fd0;
T_0 ;
    %pushi/vec4 10, 0, 8;
    %store/vec4 v000001b4dabfee60_0, 0, 8;
    %delay 7, 0;
    %vpi_call 2 7 "$display", "INFO display2.decimal=%0d", v000001b4dabfee60_0 {0 0 0};
    %vpi_call 2 8 "$display", "PASS display2.zero_width" {0 0 0};
    %vpi_call 2 9 "$display", "INFO display2.hex=%h bin=%b oct=%o", v000001b4dabfee60_0, v000001b4dabfee60_0, v000001b4dabfee60_0 {0 0 0};
    %vpi_call 2 10 "$display", "INFO display2.time=%t", $time {0 0 0};
    %vpi_call 2 11 "$display", "PASS display2.time_read" {0 0 0};
    %vpi_call 2 12 "$finish" {0 0 0};
    %end;
    .thread T_0;
