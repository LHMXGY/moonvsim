    %load/vec4 v00000214ee578e10_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_2.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v00000214ee6774d0_0, 0;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v00000214ee578eb0_0, 0;
    %jmp T_2.1;
T_2.0 ;
