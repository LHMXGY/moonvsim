    .scope S_00000150af309bc0;
T_0 ;
    %wait E_00000150af3086e0;
    %load/vec4 v00000150af3074e0_0;
    %load/vec4 v00000150af309d50_0;
    %cmp/u;
    %flag_get/vec4 5;
