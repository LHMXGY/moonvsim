    %cmpi/e 11, 0, 4;
    %jmp/0xz  T_0.4, 6;
    %vpi_call 2 16 "$display", "PASS select2.part_minus" {0 0 0};
T_0.4 ;
    %pushi/vec4 7, 0, 3;
    %store/vec4 v000001ed0e7fbeb0_0, 0, 3;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v000001ed0e7f74e0_0, 0, 8;
    %delay 1, 0;
