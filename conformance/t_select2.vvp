S_000001ed0e7fbd20 .scope module, "t_select2" "t_select2" 2 2;
 .timescale 0 0;
v000001ed0e7fc580_0 .net "bit_v", 0 0, L_000001ed0e7f9180;  1 drivers
v000001ed0e7f74e0_0 .var "d", 7 0;
v000001ed0e7fbeb0_0 .var "i", 2 0;
