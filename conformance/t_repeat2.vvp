S_0000019bf822ed20 .scope module, "t_repeat2" "t_repeat2" 2 3;
 .timescale 0 0;
v0000019bf822c510_0 .var "fast", 0 0;
v0000019bf8227500_0 .var "ticks", 3 0;
E_0000019bf82286a0 .event posedge, v0000019bf822c510_0;
    .scope S_0000019bf822ed20;
T_0 ;
    %delay 3, 0;
    %load/vec4 v0000019bf822c510_0;
    %inv;
    %store/vec4 v0000019bf822c510_0, 0, 1;
    %jmp T_0;
    .thread T_0;
    .scope S_0000019bf822ed20;
T_1 ;
    %wait E_0000019bf82286a0;
    %load/vec4 v0000019bf8227500_0;
    %addi 1, 0, 4;
    %store/vec4 v0000019bf8227500_0, 0, 4;
    %jmp T_1;
    .thread T_1;
    .scope S_0000019bf822ed20;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000019bf822c510_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0000019bf8227500_0, 0, 4;
    %delay 30, 0;
    %vpi_call 2 17 "$display", "INFO repeat2.fast=%b ticks=%0d", v0000019bf822c510_0, v0000019bf8227500_0 {0 0 0};
    %load/vec4 v0000019bf8227500_0;
    %pad/u 32;
    %cmpi/e 5, 0, 32;
    %jmp/0xz  T_2.0, 4;
    %vpi_call 2 18 "$display", "PASS repeat2.divider" {0 0 0};
T_2.0 ;
    %vpi_call 2 19 "$finish" {0 0 0};
    %end;
    .thread T_2;
