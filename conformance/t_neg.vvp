#! /mingw64/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "E:\ds\tools\iverilog\mingw64\lib\ivl\system.vpi";
:vpi_module "E:\ds\tools\iverilog\mingw64\lib\ivl\vhdl_sys.vpi";
:vpi_module "E:\ds\tools\iverilog\mingw64\lib\ivl\vhdl_textio.vpi";
:vpi_module "E:\ds\tools\iverilog\mingw64\lib\ivl\v2005_math.vpi";
:vpi_module "E:\ds\tools\iverilog\mingw64\lib\ivl\va_math.vpi";
S_000001d53b8ca1b0 .scope module, "t_neg" "t_neg" 2 2;
 .timescale 0 0;
v000001d53b8ca6a0_0 .var "both", 3 0;
v000001d53b987480_0 .var "clk", 0 0;
v000001d53b8ca740_0 .var "down", 3 0;
E_000001d53b98e8e0 .event anyedge, v000001d53b987480_0;
E_000001d53b98eca0 .event negedge, v000001d53b987480_0;
    .scope S_000001d53b8ca1b0;
T_0 ;
    %delay 5, 0;
    %load/vec4 v000001d53b987480_0;
    %inv;
    %store/vec4 v000001d53b987480_0, 0, 1;
    %jmp T_0;
    .thread T_0;
    .scope S_000001d53b8ca1b0;
T_1 ;
    %wait E_000001d53b98eca0;
    %load/vec4 v000001d53b8ca740_0;
    %addi 1, 0, 4;
    %store/vec4 v000001d53b8ca740_0, 0, 4;
    %jmp T_1;
    .thread T_1;
    .scope S_000001d53b8ca1b0;
T_2 ;
    %wait E_000001d53b98e8e0;
    %load/vec4 v000001d53b8ca6a0_0;
    %addi 1, 0, 4;
    %store/vec4 v000001d53b8ca6a0_0, 0, 4;
    %jmp T_2;
    .thread T_2, $push;
    .scope S_000001d53b8ca1b0;
T_3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001d53b987480_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v000001d53b8ca740_0, 0, 4;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v000001d53b8ca6a0_0, 0, 4;
    %delay 52, 0;
    %vpi_call 2 18 "$display", "INFO neg.down=%0d both=%0d", v000001d53b8ca740_0, v000001d53b8ca6a0_0 {0 0 0};
    %load/vec4 v000001d53b8ca740_0;
    %pad/u 32;
    %cmpi/e 5, 0, 32;
    %jmp/0xz  T_3.0, 4;
    %vpi_call 2 19 "$display", "PASS neg.negedge_count" {0 0 0};
T_3.0 ;
    %load/vec4 v000001d53b8ca6a0_0;
    %pad/u 32;
    %cmpi/e 10, 0, 32;
    %jmp/0xz  T_3.2, 4;
    %vpi_call 2 20 "$display", "PASS neg.both_edges" {0 0 0};
T_3.2 ;
    %vpi_call 2 21 "$finish" {0 0 0};
    %end;
    .thread T_3;
