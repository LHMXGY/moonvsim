S_000001f03d5deb90 .scope module, "t_display" "t_display" 2 2;
 .timescale 0 0;
v000001f03d5de7c0_0 .var "v", 7 0;
    .scope S_000001f03d5deb90;
T_0 ;
    %pushi/vec4 42, 0, 8;
    %store/vec4 v000001f03d5de7c0_0, 0, 8;
    %delay 3, 0;
    %vpi_call 2 8 "$display", "dec=%0d hex=%h bin=%b oct=%o char=%c", v000001f03d5de7c0_0, v000001f03d5de7c0_0, v000001f03d5de7c0_0, v000001f03d5de7c0_0, "A" {0 0 0};
    %vpi_call 2 9 "$display", "time=%0t", 32'sb00000000000000000000000000000111 {0 0 0};
    %vpi_call 2 10 "$display", "PASS display.format" {0 0 0};
    %vpi_call 2 11 "$finish" {0 0 0};
    %end;
    .thread T_0;
