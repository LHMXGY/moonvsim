S_000002a20989b8f0 .scope module, "t_loop" "t_loop" 2 2;
 .timescale 0 0;
v000002a20989a190_0 .var/i "acc", 31 0;
v000002a209897480_0 .var "clk", 0 0;
v000002a20989ba80_0 .var/i "k", 31 0;
v000002a20989bb20_0 .var/i "n", 31 0;
v000002a20989bbc0 .array "pipe", 3 0, 7 0;
    .scope S_000002a20989b8f0;
T_0 ;
    %delay 5, 0;
    %load/vec4 v000002a209897480_0;
    %inv;
    %store/vec4 v000002a209897480_0, 0, 1;
    %jmp T_0;
    .thread T_0;
    .scope S_000002a20989b8f0;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000002a20989a190_0, 0, 32;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v000002a20989ba80_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v000002a20989ba80_0;
    %cmpi/s 4, 0, 32;
    %flag_or 5, 4;
	  %jmp/0xz T_1.1, 5;
    %load/vec4 v000002a20989a190_0;
    %load/vec4 v000002a20989ba80_0;
    %add;
    %store/vec4 v000002a20989a190_0, 0, 32;
T_1.2 ; for-loop step statement
    %load/vec4 v000002a20989ba80_0;
    %addi 1, 0, 32;
    %store/vec4 v000002a20989ba80_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000002a20989bb20_0, 0, 32;
T_1.3 ;
    %load/vec4 v000002a20989bb20_0;
    %cmpi/s 3, 0, 32;
    %jmp/0xz T_1.4, 5;
    %load/vec4 v000002a20989bb20_0;
    %addi 1, 0, 32;
    %store/vec4 v000002a20989bb20_0, 0, 32;
    %jmp T_1.3;
T_1.4 ;
    %load/vec4 v000002a20989a190_0;
    %cmpi/e 10, 0, 32;
    %jmp/0xz  T_1.5, 4;
    %vpi_call 2 16 "$display", "PASS loop.for_sum" {0 0 0};
T_1.5 ;
    %load/vec4 v000002a20989bb20_0;
    %cmpi/e 3, 0, 32;
    %jmp/0xz  T_1.7, 4;
    %vpi_call 2 17 "$display", "PASS loop.while" {0 0 0};
T_1.7 ;
    %pushi/vec4 2, 0, 32;
T_1.9 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_1.10, 5;
    %jmp/1 T_1.10, 4;
    %subi 1, 0, 32;
    %load/vec4 v000002a20989a190_0;
    %addi 1, 0, 32;
    %store/vec4 v000002a20989a190_0, 0, 32;
    %jmp T_1.9;
T_1.10 ;
    %pop/vec4 1;
    %load/vec4 v000002a20989a190_0;
    %cmpi/e 12, 0, 32;
    %jmp/0xz  T_1.11, 4;
    %vpi_call 2 19 "$display", "PASS loop.repeat" {0 0 0};
T_1.11 ;
    %pushi/vec4 7, 0, 8;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v000002a20989bbc0, 4, 0;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v000002a20989ba80_0, 0, 32;
T_1.13 ; Top of for-loop
    %load/vec4 v000002a20989ba80_0;
    %cmpi/s 4, 0, 32;
	  %jmp/0xz T_1.14, 5;
    %pushi/vec4 0, 0, 8;
    %ix/getv/s 4, v000002a20989ba80_0;
    %store/vec4a v000002a20989bbc0, 4, 0;
T_1.15 ; for-loop step statement
    %load/vec4 v000002a20989ba80_0;
    %addi 1, 0, 32;
    %store/vec4 v000002a20989ba80_0, 0, 32;
    %jmp T_1.13;
T_1.14 ; for-loop exit label
    %delay 12, 0;
    %vpi_call 2 24 "$display", "INFO loop.acc=%0d pipe0=%0d", v000002a20989a190_0, &A<v000002a20989bbc0, 0> {0 0 0};
    %load/vec4 v000002a20989a190_0;
    %cmpi/e 12, 0, 32;
    %jmp/0xz  T_1.16, 4;
    %vpi_call 2 25 "$display", "PASS loop.after_delay" {0 0 0};
T_1.16 ;
    %vpi_call 2 26 "$finish" {0 0 0};
    %end;
    .thread T_1;
